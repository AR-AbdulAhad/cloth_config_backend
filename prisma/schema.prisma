generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EducationType {
  STX
  HF
  HHX
  HTX
  EUD
  EUX
  Efterskole
}

enum Role {
  admin
  server_owner
  class_representative
  student
}

enum LogoStatus {
  uploaded
  pending
  approved
  rejected
}

enum DesignStatus {
  uploaded
  pending
  approved
  rejected
}

enum NameListStatus {
  draft
  ready
  locked
  approved
  rejected
}

enum OrderStatus {
  in_progress
  saved
  pending_payment
  partial_paid
  completed
  cancelled
}

enum ClassStatus {
  active
  orders_locked
  production_ready
  shipped
  completed
}

model Country {
  id           Int          @id @default(autoincrement())
  name         String       @unique @db.VarChar(100)
  code         String?      @db.VarChar(10)
  status       Int          @default(0)
  created_at   DateTime     @default(now())

  back_designs BackDesign[]
  classes      Classes[]

  @@map("countries")
}

model Font {
  id              Int        @id @default(autoincrement())
  name            String     @unique @db.VarChar(100)
  google_font_url String?    @db.VarChar(500)
  preview         String?    @db.VarChar(255)
  status          Int        @default(0)
  created_at      DateTime   @default(now())

  name_lists NameList[]

  @@map("fonts")
}

model School {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(255)
  education_type EducationType
  status         Int           @default(0)
  created_at     DateTime      @default(now())

  classes Classes[]
  users   User[]
  logos   Logo[]  

  @@map("schools")
}

model Classes {
  id                  Int         @id @default(autoincrement())
  school_id           Int
  name                String      @db.VarChar(255)
  graduation_year     Int
  change_deadline     DateTime?
  order_locked        Boolean     @default(false)
  name_list_locked    Boolean     @default(false)
  process_status      ClassStatus @default(active)
  back_design_id      Int?
  country_id          Int?
  status              Int         @default(0)
  created_at          DateTime    @default(now())

  school             School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  active_back_design BackDesign?         @relation("ActiveBackDesign", fields: [back_design_id], references: [id], onDelete: SetNull)
  country            Country?            @relation(fields: [country_id], references: [id], onDelete: SetNull)
  users              User[]
  back_designs       BackDesign[]        @relation("ClassBackDesigns")
  name_lists         NameList?
  orders             Order[]
  production_package ProductionPackage[]

  @@map("classes")
}

model User {
  id                 Int      @id @default(autoincrement())
  school_id          Int?
  class_id           Int?
  name               String   @db.VarChar(255)
  email              String   @unique @db.VarChar(255)
  password           String   @db.VarChar(255)
  phone_number       String?  @db.VarChar(20)
  role               Role     @default(student)
  year_of_birth      Int?
  consent_marketing  Boolean  @default(false)
  consent_production Boolean  @default(false)
  status             Int      @default(0)
  created_at         DateTime @default(now())

  school School?  @relation(fields: [school_id], references: [id], onDelete: SetNull)
  class  Classes? @relation(fields: [class_id], references: [id], onDelete: SetNull)
  logos  Logo[]
  orders Order[]

  @@map("users")
}

model Logo {
  id             Int        @id @default(autoincrement())
  name           String     @db.VarChar(255)
  school_id      Int
  uploaded_by    Int
  file_path      String     @db.VarChar(255)
  process_status LogoStatus @default(uploaded)
  admin_comment  String?    @db.Text
  status         Int        @default(0)
  created_at     DateTime   @default(now())

  school School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("logos")
}

model BackDesign {
  id                 Int          @id @default(autoincrement())
  class_id           Int?
  country_id         Int?
  name               String       @db.VarChar(255)
  file_path          String       @db.VarChar(255)
  is_library         Boolean      @default(false)
  process_status     DesignStatus @default(uploaded)
  admin_comment      String?      @db.Text
  status             Int          @default(0)
  isFromConfigurator Boolean      @default(false)
  designColor        String?      @db.VarChar(20)
  created_at         DateTime     @default(now())

  class              Classes?     @relation("ClassBackDesigns", fields: [class_id], references: [id], onDelete: Cascade)
  country            Country?     @relation(fields: [country_id], references: [id], onDelete: SetNull)
  active_for_classes Classes[]    @relation("ActiveBackDesign")

  @@map("back_designs")
}

model NameList {
  id             Int            @id @default(autoincrement())
  class_id       Int            @unique
  font_id        Int?
  process_status NameListStatus @default(draft)
  created_at     DateTime       @default(now())
  locked_at      DateTime?

  class Classes        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  font  Font?          @relation(fields: [font_id], references: [id], onDelete: SetNull)
  items NameListItem[]

  @@map("name_lists")
}

model NameListItem {
  id           Int      @id @default(autoincrement())
  name_list_id Int
  name         String
  position     Int
  created_at   DateTime @default(now())

  nameList NameList @relation(fields: [name_list_id], references: [id], onDelete: Cascade)

  @@index([name_list_id, position])
  @@map("name_list_items")
}
model Order {
  id               Int         @id @default(autoincrement())
  student_id       Int
  class_id         Int
  selected_logo_id Int?
  delivery_details String?     @db.Text
  is_locked        Boolean     @default(false)
  process_status   OrderStatus @default(in_progress)
  status           Int         @default(0)
  version          Int         @default(1)     
  total_amount     Decimal?    @db.Decimal(10, 2) @default(0)
  amount_paid      Decimal?    @db.Decimal(10, 2) @default(0)
  payment_status   String?     @db.VarChar(50) @default("unpaid") // unpaid, partial, paid
  edit_deadline    DateTime?   // Window to edit after payment
  stripe_payment_intent String? @db.VarChar(255)
  stripe_session_id    String? @db.VarChar(255)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @default(now()) @updatedAt

  student        User           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class          Classes        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  logo           Logo?          @relation(fields: [selected_logo_id], references: [id], onDelete: SetNull)
  order_items    OrderItem[]
  order_history  OrderHistory[]
  
  @@map("orders")
}

model OrderHistory {
  id              Int      @id @default(autoincrement())
  order_id        Int
  action          String?  @db.VarChar(255)
  changed_by      Int?
  version         Int      @default(1)
  changes         Json?
  changes_summary String?  @db.VarChar(255)
  status          Int      @default(0)          // 0 = visible, 2 = deleted
  created_at      DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_history")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  order_id      Int
  product_type  String   @db.VarChar(100)
  selectedColor String?  @db.VarChar(50)
  selectedSize  String?  @db.VarChar(20)
  design_config Json?
  status        Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model ProductionPackage {
  id                Int      @id @default(autoincrement())
  class_id          Int
  package_name      String   @db.VarChar(255)
  excel_file_path   String?  @db.VarChar(255)
  pdf_file_path     String?  @db.VarChar(255)
  zip_file_path     String?  @db.VarChar(255)
  generated_at      DateTime @default(now())
  production_status String   @default("pending") @db.VarChar(50)

  class Classes @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@map("production_packages")
}
