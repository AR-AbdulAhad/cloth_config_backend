  generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



enum Role {
  admin
  server_owner
  class_representative
  student
}

enum LogoStatus {
  uploaded
  pending
  approved
  rejected
}

enum DesignStatus {
  uploaded
  pending
  approved
  rejected
}

enum NameListStatus {
  draft
  ready
  locked
  approved
  rejected
}

enum OrderStatus {
  draft
  on_hold
  locked_awaiting_payment
  paid
  in_production
  dispatched
  completed
  cancelled
  
  // Legacy/Compatibility statuses:
  in_progress
  saved
  pending_payment
  partial_paid
}

enum ClassStatus {
  active
  orders_locked
  production_ready
  shipped
  completed
}

model Country {
  id           Int          @id @default(autoincrement())
  name         String       @unique @db.VarChar(100)
  code         String?      @db.VarChar(10)
  status       Int          @default(0)
  created_at   DateTime     @default(now())

  back_designs BackDesign[]
  classes      Classes[]

  @@map("countries")
}

model Font {
  id              Int        @id @default(autoincrement())
  name            String     @unique @db.VarChar(100)
  google_font_url String?    @db.VarChar(500)
  preview         String?    @db.VarChar(255)
  status          Int        @default(0)
  created_at      DateTime   @default(now())

  name_lists NameList[]

  @@map("fonts")
}

model School {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(255)

  status         Int           @default(0)
  created_at     DateTime      @default(now())

  classes Classes[]
  users   User[]
  logos   Logo[]
  educationPrograms EducationProgram[]
  registration_tokens RegistrationToken[]

  @@map("schools")
}

model EducationProgram {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  status     Int      @default(0)
  created_at DateTime @default(now())

  schools School[]
  classes Classes[]
  users   User[]
  @@map("education_programs")
}

model Classes {
  id                  Int         @id @default(autoincrement())
  school_id           Int
  name                String      @db.VarChar(255)
  graduation_year     Int
  change_deadline     DateTime?
  order_locked        Boolean     @default(false)
  name_list_locked    Boolean     @default(false)
  process_status      ClassStatus @default(active)
  back_design_id      Int?
  country_id          Int?
  expected_students   Int?        // Target number of students for graduation caps
  status              Int         @default(0)
  education_program_id Int?
  delivery_details    String?     @db.Text
  created_at          DateTime    @default(now())

  school              School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  education_program   EducationProgram?   @relation(fields: [education_program_id], references: [id], onDelete: SetNull)
  active_back_design  BackDesign?         @relation("ActiveBackDesign", fields: [back_design_id], references: [id], onDelete: SetNull)
  country             Country?            @relation(fields: [country_id], references: [id], onDelete: SetNull)
  users               User[]
  back_designs        BackDesign[]        @relation("ClassBackDesigns")
  name_lists          NameList?
  orders             Order[]
  production_package ProductionPackage[]
  registration_tokens RegistrationToken[]

  @@map("classes")
}

model User {
  id                 Int      @id @default(autoincrement())
  school_id          Int?
  class_id           Int?
  name               String   @db.VarChar(255)
  email              String   @unique @db.VarChar(255)
  password           String   @db.VarChar(255)
  phone_number       String?  @db.VarChar(20)
  role               Role     @default(student)
  year_of_birth      Int?
  consent_marketing  Boolean  @default(false)
  consent_production Boolean  @default(false)
  reset_otp          String?  @db.VarChar(10)
  reset_otp_expires  DateTime?
  status             Int      @default(0)
  education_program_id Int?
  created_at         DateTime @default(now())

  school School?  @relation(fields: [school_id], references: [id], onDelete: SetNull)
  class  Classes? @relation(fields: [class_id], references: [id], onDelete: SetNull)
  education_program EducationProgram?  @relation(fields: [education_program_id], references: [id], onDelete: SetNull)
  logos  Logo[]
  orders Order[]
  created_registration_tokens RegistrationToken[] @relation("TokenCreator")
  redeemed_registration_tokens RegistrationToken[] @relation("TokenRedeemer")
  support_tickets         SupportTicket[]
  support_ticket_messages SupportTicketMessage[]

  @@map("users")
}

// ─── Support Tickets ────────────────────────────────────────────────────────

enum SupportTicketStatus {
  open
  replied
  closed
}

model SupportTicket {
  id          Int                  @id @default(autoincrement())
  user_id     Int
  subject     String               @db.VarChar(255)
  status      SupportTicketStatus  @default(open)
  created_at  DateTime             @default(now())

  user     User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@map("support_tickets")
}

model SupportTicketMessage {
  id         Int      @id @default(autoincrement())
  ticket_id  Int
  sender_id  Int
  message    String   @db.Text
  created_at DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("support_ticket_messages")
}

model Logo {
  id             Int        @id @default(autoincrement())
  name           String     @db.VarChar(255)
  school_id      Int
  uploaded_by    Int
  file_path      String     @db.VarChar(255)
  process_status LogoStatus @default(uploaded)
  admin_comment  String?    @db.Text
  status         Int        @default(0)
  created_at     DateTime   @default(now())

  school School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("logos")
}
model BackDesign {
  id                  Int          @id @default(autoincrement())
  class_id            Int?
  country_id          Int?
  name                String       @db.VarChar(255)

  file_path           String       @db.Text
  file_path_2         String?      @db.Text
  configured_file_path String?     @db.Text
  configured_file_path_2 String?   @db.Text
  designColor         String?      @default("white") @db.VarChar(20)
  designColor_2       String?      @default("black") @db.VarChar(20)

  is_library          Boolean      @default(false)
  forAllStudents      Boolean      @default(false)
  process_status      DesignStatus @default(uploaded)
  admin_comment       String?      @db.Text
  status              Int          @default(0)
  isFromConfigurator  Boolean      @default(false)
  configurator_state  Json?
  created_at          DateTime     @default(now())

  class              Classes?     @relation("ClassBackDesigns", fields: [class_id], references: [id], onDelete: Cascade)
  country            Country?     @relation(fields: [country_id], references: [id], onDelete: SetNull)
  active_for_classes Classes[]    @relation("ActiveBackDesign")

  @@map("back_designs")
}

model NameList {
  id             Int            @id @default(autoincrement())
  class_id       Int            @unique
  font_id        Int?
  process_status NameListStatus @default(draft)
  created_at     DateTime       @default(now())
  locked_at      DateTime?

  class Classes        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  font  Font?          @relation(fields: [font_id], references: [id], onDelete: SetNull)
  items NameListItem[]

  @@map("name_lists")
}

model NameListItem {
  id           Int      @id @default(autoincrement())
  name_list_id Int
  name         String
  position     Int
  created_at   DateTime @default(now())

  nameList NameList @relation(fields: [name_list_id], references: [id], onDelete: Cascade)

  @@index([name_list_id, position])
  @@map("name_list_items")
}
model Order {
  id               Int         @id @default(autoincrement())
  student_id       Int
  class_id         Int
  selected_logo_id Int?
  delivery_details String?     @db.Text
  is_locked        Boolean     @default(false)
  process_status   OrderStatus @default(on_hold)
  status           Int         @default(0)
  version          Int         @default(1)     
  total_amount     Decimal?    @db.Decimal(10, 2) @default(0)
  amount_paid      Decimal?    @db.Decimal(10, 2) @default(0)
  payment_status   String?     @db.VarChar(50) @default("unpaid") // unpaid, partial, paid
  edit_deadline    DateTime?   // Window to edit after payment
  stripe_payment_intent String? @db.VarChar(255)
  stripe_session_id    String? @db.VarChar(255)
  
  // Tracking Timestamps
  hold_deadline       DateTime?
  locked_at           DateTime?
  paid_at             DateTime?
  finalized_at        DateTime?
  production_started_at DateTime?
  dispatched_at       DateTime?

  created_at       DateTime    @default(now())
  updated_at       DateTime    @default(now()) @updatedAt

  student        User           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  class          Classes        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  logo           Logo?          @relation(fields: [selected_logo_id], references: [id], onDelete: SetNull)
  order_items    OrderItem[]
  order_history  OrderHistory[]
  
  @@map("orders")
}

model OrderHistory {
  id              Int      @id @default(autoincrement())
  order_id        Int
  action          String?  @db.VarChar(255)
  changed_by      Int?
  version         Int      @default(1)
  changes         Json?
  changes_summary String?  @db.VarChar(255)
  status          Int      @default(0)          // 0 = visible, 2 = deleted
  created_at      DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_history")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  order_id      Int
  product_type  String   @db.VarChar(100)
  selectedColor String?  @db.VarChar(50)
  selectedSize  String?  @db.VarChar(20)
  design_config Json?
  status        Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model ProductionPackage {
  id                Int      @id @default(autoincrement())
  class_id          Int
  package_name      String   @db.VarChar(255)
  excel_file_path   String?  @db.VarChar(255)
  pdf_file_path     String?  @db.VarChar(255)
  zip_file_path     String?  @db.VarChar(255)
  generated_at      DateTime @default(now())
  production_status String   @default("pending") @db.VarChar(50)

  class Classes @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@map("production_packages")
}

enum RegistrationTokenStatus {
  unused
  used
}

model RegistrationToken {
  id          Int                     @id @default(autoincrement())
  token       String                  @unique @db.VarChar(64)
  school_id   Int
  class_id    Int
  status      RegistrationTokenStatus @default(unused)
  created_by  Int
  used_by     Int?
  expires_at  DateTime
  used_at     DateTime?
  created_at  DateTime                @default(now())

  school  School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  class   Classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  creator User     @relation("TokenCreator", fields: [created_by], references: [id], onDelete: Cascade)
  usedByUser User? @relation("TokenRedeemer", fields: [used_by], references: [id], onDelete: SetNull)

  @@index([class_id, status, expires_at])
  @@map("registration_tokens")
}

model Setting {
  id             Int      @id @default(autoincrement())
  key            String   @unique @db.VarChar(100)
  value          String   @db.VarChar(500)
  description    String?  @db.VarChar(255)
  updated_at     DateTime @default(now()) @updatedAt

  @@map("settings")
}

model ShippingRate {
  id           Int      @id @default(autoincrement())
  country_name String   @db.VarChar(100)
  country_code String?  @db.VarChar(10)
  regular_delivery_rate         Decimal  @db.Decimal(10, 2)
  express_delivery_rate         Decimal  @db.Decimal(10, 2)
  currency     String   @default("DKK") @db.VarChar(10)
  description  String?  @db.VarChar(255)
  status       Int      @default(0)   // 0 = active, 1 = inactive
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@unique([country_name])
  @@map("shipping_rates")
}

model Campaign {
  id            Int            @id @default(autoincrement())
  title         String         @db.VarChar(255)
  subject       String         @db.VarChar(255)
  html_body     String         @db.Text
  template_id   Int?
  target_type   String         @db.VarChar(50)
  target_id     Int?
  target_role   String?        @db.VarChar(50)
  sent_count    Int            @default(0)
  failed_count  Int            @default(0)
  status        String         @default("draft") @db.VarChar(50)
  scheduled_at  DateTime?
  sent_at       DateTime?
  created_at    DateTime       @default(now())

  template      EmailTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@map("campaigns")
}

model EmailTemplate {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(255)
  subject     String     @db.VarChar(255)
  html_body   String     @db.Text
  category    String     @db.VarChar(100)
  is_default  Boolean    @default(false)
  status      Int        @default(0)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @default(now()) @updatedAt

  // NEW: Automation fields
  is_automated     Boolean  @default(false)
  automation_type  String?  @db.VarChar(50)
  trigger_events   String?  @db.Text  // JSON string
  target_audience  String?  @db.Text  // JSON string  
  delay_hours      Int?     @default(0)
  design           Json?    // Email editor design JSON

  campaigns   Campaign[]

  @@map("email_templates")
}
